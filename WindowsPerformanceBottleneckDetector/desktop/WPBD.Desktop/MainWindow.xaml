<Window x:Class="WPBD.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:WPBD.Desktop"
        Title="WPBD | Windows Performance Bottleneck Detector" Width="1120" Height="780" MinWidth="690" MinHeight="405"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Background}" Foreground="{StaticResource Text}"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True">
    <Grid Margin="17">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,13" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Logs" Command="{Binding OpenLogsCommand}" Margin="0,0,6,0"/>
                <Button Content="About" Command="{Binding AboutCommand}"/>
            </StackPanel>
            <StackPanel>
                <WrapPanel VerticalAlignment="Center">
                    <TextBlock Text="WPBD" FontSize="27" FontWeight="Bold" Margin="0,0,9,0"/>
                    <TextBlock Text="0.3" Foreground="{StaticResource Cpu}" VerticalAlignment="Center" Margin="0,3,13,0"/>
                    <Border CornerRadius="5" Background="{StaticResource Raised}" Padding="8,4" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Status}" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite"/>
                    </Border>
                </WrapPanel>
                <TextBlock Text="Windows Performance Bottleneck Detector" Style="{StaticResource MutedText}"/>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Style="{StaticResource PanelSurface}" Margin="0,0,0,11">
            <StackPanel>
                <WrapPanel>
                    <StackPanel Margin="0,0,16,7" MinWidth="106" VerticalAlignment="Center">
                        <TextBlock Text="Local workstation" Style="{StaticResource MutedText}" FontSize="11"/>
                        <TextBlock Text="{Binding Computer}" FontWeight="SemiBold" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,8,7" Width="116">
                        <TextBlock Text="Duration" Style="{StaticResource MutedText}" FontSize="11"/>
                        <ComboBox ItemsSource="{Binding Durations}" SelectedValue="{Binding Duration}" SelectedValuePath="Seconds"
                                  DisplayMemberPath="Label" IsEnabled="{Binding CanConfigure}" AutomationProperties.Name="Diagnostic duration"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,7" Width="72">
                        <TextBlock Text="Interval (s)" Style="{StaticResource MutedText}" FontSize="11"/>
                        <ComboBox ItemsSource="{Binding Intervals}" SelectedItem="{Binding Interval}" IsEnabled="{Binding CanConfigure}"
                                  AutomationProperties.Name="Sampling interval in seconds"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,7">
                        <Button Content="Start Diagnostic" Command="{Binding StartCommand}" Style="{StaticResource StartButton}" Margin="0,0,6,0"/>
                        <Button Content="Cancel Diagnostic" Command="{Binding CancelCommand}"/>
                    </StackPanel>
                </WrapPanel>
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right" Content="Choose folder" Command="{Binding ChooseFolderCommand}" Margin="8,0,0,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Report location" Style="{StaticResource MutedText}" FontSize="11"/>
                        <TextBlock Text="{Binding OutputDirectory}" TextTrimming="CharacterEllipsis" ToolTip="{Binding OutputDirectory}"/>
                    </StackPanel>
                </DockPanel>
                <CheckBox Content="Allow process-only script policy override" IsChecked="{Binding PolicyOverride}" IsEnabled="{Binding CanConfigure}"
                          Foreground="{StaticResource Muted}" Margin="0,7,0,0"
                          ToolTip="Use only where organisational policy permits. The setting is passed to this PowerShell worker."/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource PanelSurface}" Margin="0,0,0,9" Padding="11,8"
                Visibility="{Binding HasError, Converter={StaticResource Visibility}}" BorderBrush="{StaticResource Critical}">
            <StackPanel>
                <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="{StaticResource Critical}" AutomationProperties.LiveSetting="Assertive"/>
                <Expander Header="Technical details">
                    <ScrollViewer MaxHeight="95" VerticalScrollBarVisibility="Auto">
                        <TextBlock Text="{Binding TechnicalDetails}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11"/>
                    </ScrollViewer>
                </Expander>
            </StackPanel>
        </Border>

        <TabControl Grid.Row="3" SelectedIndex="{Binding SelectedTab, Mode=TwoWay}" AutomationProperties.Name="Diagnostic views">
            <TabItem Header="Dashboard">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Border Style="{StaticResource PanelSurface}" Margin="0,0,0,9" Padding="12,9">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Elapsed}" FontWeight="SemiBold" Margin="8,0,0,0"/>
                                    <TextBlock Text="{Binding Activity}" TextWrapping="Wrap"/>
                                </DockPanel>
                                <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressValue, Mode=OneWay}"
                                             IsIndeterminate="{Binding IsIndeterminate}" Height="6" Margin="0,7"
                                             Foreground="{StaticResource Cpu}" Background="{StaticResource Raised}"
                                             AutomationProperties.Name="Diagnostic sampling progress"/>
                                <TextBlock Text="{Binding SampleProgress}" Style="{StaticResource MutedText}" FontSize="11"/>
                            </StackPanel>
                        </Border>
                        <UniformGrid Columns="4" Margin="0,0,-8,0">
                            <Border Style="{StaticResource PanelSurface}" Margin="0,0,8,8">
                                <StackPanel>
                                    <TextBlock Text="CPU utilisation" Foreground="{StaticResource Cpu}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding CpuValue}" Style="{StaticResource TileValue}" AutomationProperties.Name="CPU utilisation"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource PanelSurface}" Margin="0,0,8,8">
                                <StackPanel>
                                    <TextBlock Text="Physical memory" Foreground="{StaticResource Memory}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding MemoryValue}" Style="{StaticResource TileValue}" AutomationProperties.Name="Physical memory utilisation"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource PanelSurface}" Margin="0,0,8,8">
                                <StackPanel>
                                    <TextBlock Text="Available memory" Foreground="{StaticResource Memory}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding AvailableValue}" Style="{StaticResource TileValue}" AutomationProperties.Name="Available memory"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource PanelSurface}" Margin="0,0,8,8">
                                <StackPanel>
                                    <TextBlock Text="Peak disk latency" Foreground="{StaticResource Storage}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding StorageValue}" Style="{StaticResource TileValue}" AutomationProperties.Name="Peak disk latency"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                        <Border Style="{StaticResource PanelSurface}" Padding="12,7" Margin="0,0,0,8">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding SampleLabel}" Margin="0,0,14,0" VerticalAlignment="Center"/>
                                    <Slider Minimum="0" Maximum="{Binding TimelineMaximum}" Value="{Binding TimelineIndex, Mode=TwoWay}"
                                            IsEnabled="{Binding HasTimeline}" TickFrequency="1" IsSnapToTickEnabled="True"
                                            IsMoveToPointEnabled="True" AutomationProperties.Name="Inspect a sample"/>
                                </DockPanel>
                                <Expander Header="{Binding StorageActivity}">
                                    <TextBlock Text="{Binding DiskDetails}" TextWrapping="Wrap" Margin="4,5,0,3"/>
                                </Expander>
                            </StackPanel>
                        </Border>
                        <UniformGrid Columns="2" Margin="0,0,-8,0">
                            <Border Style="{StaticResource PanelSurface}" Margin="0,0,8,8">
                                <StackPanel>
                                    <TextBlock Text="CPU utilisation (%)" Style="{StaticResource Heading}"/>
                                    <local:MetricChart Height="145" Metric="Cpu" LineBrush="{StaticResource Cpu}"
                                                       Samples="{Binding Timeline}" CursorIndex="{Binding TimelineIndex}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource PanelSurface}" Margin="0,0,8,8">
                                <StackPanel>
                                    <TextBlock Text="Physical memory utilisation (%)" Style="{StaticResource Heading}"/>
                                    <local:MetricChart Height="145" Metric="Memory" LineBrush="{StaticResource Memory}"
                                                       Samples="{Binding Timeline}" CursorIndex="{Binding TimelineIndex}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource PanelSurface}" Margin="0,0,8,8">
                                <StackPanel>
                                    <TextBlock Text="Available memory (GiB)" Style="{StaticResource Heading}"/>
                                    <local:MetricChart Height="145" Metric="Available" LineBrush="{StaticResource Memory}"
                                                       Samples="{Binding Timeline}" CursorIndex="{Binding TimelineIndex}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource PanelSurface}" Margin="0,0,8,8">
                                <StackPanel>
                                    <TextBlock Text="Highest read or write disk latency (ms)" Style="{StaticResource Heading}"/>
                                    <local:MetricChart Height="145" Metric="Disk" LineBrush="{StaticResource Storage}"
                                                       Samples="{Binding Timeline}" CursorIndex="{Binding TimelineIndex}"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Findings">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource PanelSurface}" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="{Binding Assessment}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding ReportContext}" Style="{StaticResource MutedText}" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PanelSurface}" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="Sampling quality" Style="{StaticResource Heading}"/>
                                <TextBlock Text="{Binding QualitySummary}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                <TextBlock Text="{Binding TimingSummary}" Style="{StaticResource MutedText}"/>
                                <ItemsControl ItemsSource="{Binding CoverageGaps}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding StringFormat='Coverage gap · {0}'}" TextWrapping="Wrap" Foreground="{StaticResource Memory}" Margin="0,5,0,0"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ItemsControl ItemsSource="{Binding CollectionErrors}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource MutedText}" Margin="0,5,0,0"/></DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <ItemsControl ItemsSource="{Binding Findings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource PanelSurface}" Margin="0,0,0,8">
                                        <StackPanel>
                                            <WrapPanel>
                                                <TextBlock Text="{Binding Level}" Style="{StaticResource FindingLevel}" Margin="0,0,9,0"/>
                                                <TextBlock Text="{Binding Confidence, StringFormat='{}{0} confidence'}" Style="{StaticResource MutedText}"/>
                                            </WrapPanel>
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource Heading}" Margin="0,4,0,6"/>
                                            <TextBlock Text="Observed" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Observed}" TextWrapping="Wrap" Margin="0,1,0,6"/>
                                            <TextBlock Text="Interpretation" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Interpretation}" TextWrapping="Wrap" Margin="0,1,0,6"/>
                                            <TextBlock Text="Suggested investigation" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Investigation}" TextWrapping="Wrap" Margin="0,1,0,0"/>
                                            <Expander Header="Supporting measurements">
                                                <TextBlock Text="{Binding Evidence}" TextWrapping="Wrap" Style="{StaticResource MutedText}" Margin="5"/>
                                            </Expander>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Processes">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" Style="{StaticResource MutedText}"
                               Text="Ranked processes from the loaded report. Select a column to sort. CPU percentages use total machine capacity."/>
                    <DataGrid ItemsSource="{Binding Processes}" AlternationCount="2" AutomationProperties.Name="Ranked processes">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Process" Binding="{Binding Name}" Width="140" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="64" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="Average CPU (%)" Binding="{Binding AverageCpuPercent, StringFormat=F2, TargetNullValue=Unavailable}" Width="113" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="Peak CPU (%)" Binding="{Binding PeakCpuPercent, StringFormat=F2, TargetNullValue=Unavailable}" Width="100" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="CPU time (s)" Binding="{Binding CpuSeconds, StringFormat=F2, TargetNullValue=Unavailable}" Width="91" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="Private peak (MiB)" Binding="{Binding PrivateMiB, StringFormat=F1, TargetNullValue=Unavailable}" Width="125" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="Working set (MiB)" Binding="{Binding WorkingSetMiB, StringFormat=F1, TargetNullValue=Unavailable}" Width="127" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="Executable path" Binding="{Binding Path, TargetNullValue=Unavailable}" Width="*" MinWidth="180" ElementStyle="{StaticResource CellText}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem Header="Reports">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource PanelSurface}" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="Current report" Style="{StaticResource Heading}"/>
                            <TextBlock Text="{Binding ReportPath}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ReportPath}" Margin="0,3,0,7"/>
                            <WrapPanel>
                                <Button Content="Open HTML report" Command="{Binding OpenHtmlCommand}" Margin="0,0,6,5"/>
                                <Button Content="Open reports folder" Command="{Binding OpenFolderCommand}" Margin="0,0,6,5"/>
                                <Button Content="Browse JSON…" Command="{Binding BrowseReportCommand}" Margin="0,0,6,5"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Refresh" Command="{Binding RefreshCommand}" Margin="0,0,6,0"/>
                            <Button Content="Load selected" Command="{Binding LoadSelectedCommand}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Report history" Style="{StaticResource Heading}"/>
                            <TextBlock Text="{Binding HistoryStatus}" Style="{StaticResource MutedText}"/>
                        </StackPanel>
                    </DockPanel>
                    <DataGrid ItemsSource="{Binding History}" SelectedItem="{Binding SelectedHistory}" AlternationCount="2"
                              AutomationProperties.Name="Report history">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="JSON report" Binding="{Binding FileName}" Width="*" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="Modified" Binding="{Binding Modified, StringFormat=g}" Width="155" ElementStyle="{StaticResource CellText}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
